# FitOS environment. Copy to .env: `cp .env.example .env`
# Everything below is OPTIONAL. With no keys set, the backend runs fully offline
# using deterministic keyword review-mining + template explanations.

# --- AMD Developer Cloud vLLM (ROCm) serving Gemma, OpenAI-compatible ---
# Batch review-mining / chart-parsing path. Leave blank to skip.
GEMMA_URL=
GEMMA_MODEL=gemma-2-9b-it

# --- Fireworks AI (low-latency live explanation path + Gemma side prize) ---
FIREWORKS_API_KEY=
FIREWORKS_MODEL=accounts/fireworks/models/gemma-2-9b-it

# --- Behaviour ---
USE_CACHE=true          # read/write data/cache/*.json for LLM outputs
LLM_TIMEOUT_S=20
# DATABASE_URL=sqlite:////data/fitos.db   # override the default on-disk path

# --- AMD benchmark harness (tools/amd_benchmark/, standalone proof scripts) ---
# Used only by the P6 proof/benchmark tooling, not by the backend.
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
AMD_LLM_URL=
AMD_LLM_MODEL=fitos-gemma
LLM_TIMEOUT_SECONDS=20
LLM_TEMPERATURE=0.2
LLM_PROMPT_VERSION=v1
REVIEW_INPUT_PATH=data/sample/reviews.sample.json
REVIEW_ANALYSIS_OUTPUT_PATH=data/processed/review_analysis.example.json
REVIEW_ANALYSIS_MODE=local
SIZE_CHART_INPUT_PATH=data/sample/raw_size_charts.sample.json
SIZE_CHART_OUTPUT_PATH=data/processed/parsed_size_charts.example.json
SIZE_CHART_PARSE_MODE=local
